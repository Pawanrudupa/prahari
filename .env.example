# Database
DATABASE_URL=postgresql+asyncpg://prahari:prahari@localhost:5432/prahari
POSTGRES_USER=prahari
POSTGRES_PASSWORD=prahari
POSTGRES_DB=prahari

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
ENV=development

# Security & Governance
ADMIN_TOKEN=prahari-admin-dev-secret
AUDIT_HMAC_KEY=prahari-audit-checkpoint-hmac-secret
AUDIT_CHECKPOINT_INTERVAL=50
SESSION_SECRET_KEY=prahari-session-dev-secret
LIMITS_FAIL_OPEN=false

# LLM (Phase 4+, provider-neutral)
# LLM_PROVIDER=
# LLM_API_KEY=
# LLM_MODEL=

# Embedding model (Phase 4+)
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
